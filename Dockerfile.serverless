# =============================================================
#  MuseTalk - variante RunPod Serverless
#  Part de l'image de base (code + poids) et ajoute le handler.
#
#  Build :
#    docker build -f Dockerfile.serverless \
#      --build-arg BASE=ghcr.io/<owner>/musetalk:v1.5 \
#      -t ghcr.io/<owner>/musetalk-serverless:v1.5 .
# =============================================================
ARG BASE=ghcr.io/marwanefo/musetalk:v1.5
FROM ${BASE}

# Le SDK RunPod et requests pour récupérer l'audio distant.
RUN pip install --no-cache-dir runpod requests

COPY handler.py /opt/MuseTalk/handler.py

# Les avatars pré-calculés ne sont PAS dans l'image : un seul avatar pèse
# plusieurs Go (full_imgs). Ils viennent du volume réseau que RunPod monte
# sur /runpod-volume. L'endpoint Serverless doit donc être créé dans la même
# région que le volume.
ENV MUSETALK_ROOT=/opt/MuseTalk \
    AVATAR_ID=Inna \
    AVATARS_DIR=/runpod-volume/musetalk/results/v15/avatars \
    PYTHONUNBUFFERED=1

WORKDIR /opt/MuseTalk

# Le Serverless n'utilise pas l'entrypoint de l'image de base.
ENTRYPOINT []
CMD ["python", "-u", "/opt/MuseTalk/handler.py"]
