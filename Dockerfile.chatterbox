# Chatterbox Multilingual v3 (Resemble AI, MIT) en image Serverless.
#
# Troisieme moteur vocal, publie a cote de XTTS-v2 et non a sa place. La
# raison principale n'est pas la qualite mais la licence : les poids XTTS
# sont sous Coqui Public Model License, donc non commerciaux, et Coqui a
# ferme en janvier 2024 -- il n'y a plus personne a qui acheter une licence.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/opt/hf \
    VOICES_DIR=/opt/voices \
    DEFAULT_VOICE=inna \
    CHATTERBOX_T3=v3

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3.10 python3.10-dev python3-pip git curl ca-certificates \
      ffmpeg libsndfile1 libgl1 libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/* \
 && ln -sf /usr/bin/python3.10 /usr/local/bin/python \
 && ln -sf /usr/bin/python3.10 /usr/local/bin/python3

# Installation depuis le depot, pas depuis PyPI : la version publiee n'expose
# pas toujours le dernier modele multilingue, et c'est le v3 qu'on veut.
#
# On n'edite PAS pyproject.toml. Une version precedente y retirait gradio par
# sed ; cela cassait les metadonnees, pip construisait un paquet anonyme
# "UNKNOWN-0.0.0" sans aucune dependance, et chatterbox n'etait en fait jamais
# installe. L'import ci-dessous echouerait desormais si cela se reproduisait.
RUN git clone --depth 1 https://github.com/resemble-ai/chatterbox.git /opt/chatterbox \
 && cd /opt/chatterbox \
 && pip install --no-cache-dir . \
 && python -c "import chatterbox; print('chatterbox installe')" \
 && rm -rf /opt/chatterbox/.git

# Les outils du worker ensuite. runpod tire numpy 2.x alors que chatterbox
# exige la serie 1 : on remet donc numpy en place a la fin, en --no-deps pour
# ne pas relancer la cascade. gradio part au passage : c'est l'interface de
# demonstration, inutile dans un worker et lourde d'une centaine de Mo.
RUN pip install --no-cache-dir runpod requests soundfile \
 && pip uninstall -y gradio gradio-client || true \
 && pip install --no-cache-dir --force-reinstall --no-deps "numpy==1.26.4" \
 && python -c "\
import numpy, chatterbox; \
assert numpy.__version__.startswith('1.'), 'numpy remonte en ' + numpy.__version__; \
print('numpy', numpy.__version__, '| chatterbox present')"

# --- Poids ---------------------------------------------------------------
# Tout est embarque : un worker Serverless ne doit rien telecharger au
# demarrage. La liste reprend exactement celle de from_pretrained pour le
# modele v3 -- un fichier de plus serait du poids mort, un de moins un echec
# au premier job.
RUN python -c "\
from huggingface_hub import snapshot_download; \
snapshot_download(repo_id='ResembleAI/chatterbox', \
    allow_patterns=['ve.pt', 't3_mtl23ls_v3.safetensors', 's3gen.pt', \
                    'grapheme_mtl_merged_expanded_v1.json', 'conds.pt', \
                    'Cangjie5_TC.json']); \
print('poids chatterbox en cache')"

# --- Voix de reference ---------------------------------------------------
# Le clonage est zero-shot : ces WAV suffisent, aucun entrainement.
COPY voices/ /opt/voices/

# --- Handler -------------------------------------------------------------
COPY handler_chatterbox.py /opt/handler.py
WORKDIR /opt

# Verification a la construction : mieux vaut echouer ici, ou le journal est
# lisible, qu'au premier job sur un worker distant.
RUN python -c "\
import torch, soundfile, numpy, os; \
from chatterbox.mtl_tts import ChatterboxMultilingualTTS, SUPPORTED_LANGUAGES, MULTILINGUAL_T3_MODELS; \
assert 'v3' in MULTILINGUAL_T3_MODELS, 'modele v3 absent de cette version'; \
assert 'fr' in SUPPORTED_LANGUAGES and 'ar' in SUPPORTED_LANGUAGES; \
voix = sorted(f for f in os.listdir('/opt/voices') if f.endswith('.wav')); \
assert voix, 'aucune voix embarquee'; \
print('torch', torch.__version__, '| numpy', numpy.__version__, '|', \
      len(SUPPORTED_LANGUAGES), 'langues |', voix)"

CMD ["python", "-u", "handler.py"]
