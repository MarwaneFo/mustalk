# =============================================================
#  MuseTalk Serverless - image AUTONOME (avatar embarque)
#
#  Pourquoi cette variante ?
#  Tant que l'avatar vit sur un network volume, l'endpoint est verrouille
#  sur le data center de ce volume (us-nc-1), ou la capacite GPU s'est
#  revelee quasi nulle : aucun worker alloue en plusieurs heures d'essais.
#  En embarquant l'avatar, le volume devient inutile et TOUS les data
#  centers redeviennent eligibles.
#
#  Astuce de taille : full_imgs pese 3,2 Go a lui seul, alors que ce ne sont
#  que les frames extraites de Inna.mp4. On embarque donc la video (26 Mo)
#  et le handler regenere les frames au demarrage avec ffmpeg. L'image ne
#  grossit que d'environ 120 Mo au lieu de 3,4 Go.
#
#  Construite par-dessus :cu124 : le build prend 2 min au lieu de 30.
# =============================================================
ARG BASE=ghcr.io/marwanefo/musetalk-serverless:cu124
FROM ${BASE}

# ---------- Avatar (partie legere) ----------
# --no-same-owner est INDISPENSABLE : l'archive vient d'un volume reseau RunPod
# ou les fichiers appartiennent a l'UID 100000. Sans cette option, tar restaure
# ce proprietaire dans la couche, et le moteur de conteneurs de RunPod -- qui
# remappe les UID -- refuse d'extraire l'image :
#   failed to register layer: container ID 100000 cannot be mapped to a host ID
# Le telechargement aboutit, l'extraction echoue, le worker boucle a l'infini.
#
# L'archive est decoupee en morceaux de 45 Mo : GitHub refuse les fichiers
# de plus de 100 Mo et en deconseille au-dela de 50.
COPY avatar/inna_light.tgz.part* /tmp/av/
RUN mkdir -p /opt/MuseTalk/results/v15/avatars \
 && cat /tmp/av/inna_light.tgz.part* | tar xz --no-same-owner -C /opt/MuseTalk/results/v15/avatars \
 && rm -rf /tmp/av \
 && echo "--- avatar embarque ---" \
 && ls -la /opt/MuseTalk/results/v15/avatars/Inna \
 && echo "masques : $(ls /opt/MuseTalk/results/v15/avatars/Inna/mask | wc -l)"

# ---------- Video source (pour regenerer full_imgs) ----------
COPY avatar/Inna.mp4 /opt/MuseTalk/data/video/Inna.mp4


# ---------- Restauration de visage (optionnelle) ----------
# MuseTalk genere la bouche a basse resolution avant de la recoller dans
# une image 1080p : la zone regeneree est donc plus molle que le reste du
# visage. GFPGAN reconstruit du detail, applique aux seules images produites
# (leur nombre suit la duree de l audio, pas celle de l avatar).
#
# basicsr importe torchvision.transforms.functional_tensor, supprime depuis
# torchvision 0.17. On corrige l import plutot que de retrograder torchvision,
# dont dependent MuseTalk et la pile OpenMMLab.
# gfpgan tire basicsr, qui remonte numpy en version 2 -- or opencv, deja
# present, est compile contre numpy 1.x. Sans restauration, tout import de
# cv2 echoue sur "numpy.core.multiarray failed to import", y compris dans
# MuseTalk. On reinstalle donc numpy et opencv aux versions de l image, et
# on verifie que la pile complete cohabite avant de poursuivre.
COPY patch_basicsr.py /tmp/patch_basicsr.py
RUN pip install --no-cache-dir gfpgan==1.3.8 \
 && pip install --no-cache-dir --force-reinstall --no-deps \
      "numpy==1.23.5" "opencv-python==4.9.0.80" \
 && python /tmp/patch_basicsr.py \
 && rm -f /tmp/patch_basicsr.py \
 && python -c "\
import numpy, cv2; \
from gfpgan import GFPGANer; \
import basicsr, facexlib; \
print('numpy', numpy.__version__, '| cv2', cv2.__version__, \
      '| basicsr', basicsr.__version__, '| gfpgan OK')"

# Poids GFPGAN (~350 Mo), telecharges au build comme le reste.
RUN mkdir -p /opt/gfpgan \
 && curl -fsSL -o /opt/gfpgan/GFPGANv1.4.pth \
      https://github.com/TencentARC/GFPGAN/releases/download/v1.3.0/GFPGANv1.4.pth \
 && ls -la /opt/gfpgan/

ENV GFPGAN_MODEL=/opt/gfpgan/GFPGANv1.4.pth

COPY handler.py /opt/MuseTalk/handler.py

# AVATARS_DIR vide : le handler filtre les valeurs vides, il tombera donc
# sur l'avatar embarque dans l'image au lieu de chercher /runpod-volume.
ENV MUSETALK_ROOT=/opt/MuseTalk \
    AVATAR_ID=Inna \
    AVATARS_DIR="" \
    AVATAR_VIDEO=/opt/MuseTalk/data/video/Inna.mp4 \
    PYTHONUNBUFFERED=1

WORKDIR /opt/MuseTalk
ENTRYPOINT []
CMD ["python", "-u", "/opt/MuseTalk/handler.py"]
